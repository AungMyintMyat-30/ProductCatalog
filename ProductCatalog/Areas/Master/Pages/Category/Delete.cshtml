@page
@model ProductCatalog.Areas.Master.Pages.Category.DeleteModel
@{
    ViewBag.Title = "Category";
    ViewBag.pageTitle = "Categories";
}

<div class="row d-flex justify-content-center">
    <div class="col-xl-5 col-lg-6 col-md-7 col-sm-10">
        <div class="card">
            <div class="card-header bg-light">
                <div class="card-title text-danger">
                    <h5 class="mb-0">Delete Category</h5>
                </div>
            </div>
            <div class="card-body">
                <form id="categoryForm" method="post">
                    <div id="checkCat" class="alert alert-danger">
                        <span>You can't delete this category because it was already created in subcategory.</span>
                    </div>
                    <p>Are you sure want to delete this <b>@Model.Category!.CatName</b> ?</p>
                    <input type="hidden" asp-for="Category!.CatId" />
                    <input type="hidden" asp-for="Category!.CatName" />
                    <div class="form-group">
                        <input id="btndelete" type="submit" value="Delete" class="btn btn-danger" />
                        <a class="btn btn-secondary" asp-page="./Index" asp-area="Master">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<partial name="_Admin_Vendor_Scripts" />

<script src="~/lib/crypto-js/crypto-js.min.js"></script>
<script src="~/lib/crypto-js/aes.min.js"></script>

<script>
    $(document).ready(function () {
        menu_master_category();

        var cid = (new URL(location.href)).searchParams.get('id');
        var decrypt_cid = cryptoDecrypt(decodeURIComponent(cid));
        var url = '@Url.Content("~/")' + "api/master/category/" + decrypt_cid;
        $.getJSON(url, function (data) {
            var data = data["data"];
            console.log(data);
            if (data !== null) {
                $("#checkCat").show();
                document.getElementById('btndelete').disabled = true;
            }
            else {
                $("#checkCat").hide();
                document.getElementById('btndelete').disabled = false;
            }
        });
    })
</script>