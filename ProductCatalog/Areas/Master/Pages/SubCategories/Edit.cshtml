@page
@model ProductCatalog.Areas.Master.Pages.SubCategories.EditModel
@{
    ViewBag.Title = "SubCategory";
    ViewBag.pageTitle = "SubCategories";
}

<link href="~/admin-lte/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />

<div class="row d-flex justify-content-center">
    <div class="col-xl-5 col-lg-6 col-md-7 col-sm-10">
        <div class="card">
            <div class="card-header bg-light">
                <div class="card-title">
                    <h5 class="mb-0">Update SubCategory</h5>
                </div>
            </div>
            <div class="card-body">
                <form id="subcategoryForm" method="post">
                    <input asp-for="ViSubCategory!.SubId" hidden />
                    <input asp-for="ViSubCategory!.CatName" hidden />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label class="control-label">SubCategory Name</label>
                        <input asp-for="ViSubCategory!.SubName" class="form-control" placeholder="Enter subcategory name..." required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="control-label">Category</label>
                        <select id="DDLCategory" asp-for="ViSubCategory!.CatId" class="form-control form-select select2" required></select>
                        @* <div class="invalid-feedback">
                        Please choose category
                        </div> *@
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Update" class="btn btn-info" />
                        <a class="btn btn-secondary" asp-page="./Index" asp-area="Master">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<partial name="_Admin_Vendor_Scripts" />

<script src="~/admin-lte/libs/select2/js/select2.min.js"></script>
<!-- jquery-validation -->
<script src="~/plugins/jquery-validation/jquery.validate.min.js"></script>
<script src="~/plugins/jquery-validation/additional-methods.min.js"></script>

<script>
    $(document).ready(function () {
        menu_master_subcategory();

        // State API Requset
        var url = '@Url.Content("~/")' + "api/master/category";
        $.getJSON(url, function (data) {
            var jList = data["data"];
            var items = '';
            items += "<option selected value=''>-- Choose Category --</option>";
            $('DDLCategory').empty();
            $.each(jList, function (i, cat) {
                items += "<option class='select2-item' value='" + cat.catId + "'>" + cat.catName + "</option>";
            });
            $('#DDLCategory').html(items);

            var catId = "@Model.ViSubCategory!.CatId";
            $("#DDLCategory").val(catId).change();
        });

        $('#subcategoryForm').validate({
            rules: {
                'ViSubCategory.SubName': {
                    required: true,
                },
                'ViSubCategory.CatId': {
                    required: true,
                }
            },
            messages: {
                'ViSubCategory.SubName': {
                    required: "Please enter a subcategory name",
                },
                'ViSubCategory.CatId': {
                    required: "Please choose a category",
                }
            },
            errorElement: 'span',
            errorPlacement: function (error, element) {
                error.addClass('invalid-feedback');
                element.closest('.form-group').append(error);
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass('is-invalid');
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass('is-invalid');
            }
        });
    })
</script>